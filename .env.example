# Database
DATABASE_URL="postgresql://user:password@localhost:5432/orden_interno?schema=public"

# Backend API
API_PORT=3001
API_HOST=localhost
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# CORS
CORS_ORIGIN=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@orden-interno.com

# Supersolidaria SICSES (Configuration)
SICSES_REPORTS_DIR=./reports
SICSES_VALIDATION_STRICT=true
